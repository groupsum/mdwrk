{
  "version": "1.0.0",
  "type": "module",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20 <23"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "name": "@mdwrk/theme-preview",
  "description": "Preview runtime helpers for applying MdWrk theme drafts across editor and renderer surfaces.",
  "sideEffects": false,
  "keywords": [
    "markdown-workspace",
    "shared",
    "themes",
    "preview"
  ],
  "dependencies": {
    "@mdwrk/theme-contract": "^1.1.5",
    "@mdwrk/ui-tokens": "^1.2.6"
  },
  "scripts": {
    "build:deps": "npm run build -w @mdwrk/theme-contract && npm run build -w @mdwrk/ui-tokens",
    "build": "npm run build:deps && tsc -p tsconfig.json",
    "typecheck": "npm run build:deps && tsc --noEmit -p tsconfig.json",
    "lint": "npm run typecheck",
    "test": "npm run build && node ../../../tools/testing/prepare-workspace-links.mjs @mdwrk/theme-contract @mdwrk/ui-tokens && node ./tests/theme-preview.t0.mjs && node ./tests/theme-preview.t1.mjs && node ./tests/theme-preview.t2.mjs",
    "prepack": "npm run build"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./version": {
      "types": "./dist/version.d.ts",
      "import": "./dist/version.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    },
    "./preview-targets": {
      "types": "./dist/previewTargets.d.ts",
      "import": "./dist/previewTargets.js"
    },
    "./bridge-variables": {
      "types": "./dist/bridgeVariables.d.ts",
      "import": "./dist/bridgeVariables.js"
    },
    "./create-preview-style-sheet": {
      "types": "./dist/createPreviewStyleSheet.d.ts",
      "import": "./dist/createPreviewStyleSheet.js"
    },
    "./apply-theme-draft": {
      "types": "./dist/applyThemeDraft.d.ts",
      "import": "./dist/applyThemeDraft.js"
    },
    "./mount-theme-preview": {
      "types": "./dist/mountThemePreview.d.ts",
      "import": "./dist/mountThemePreview.js"
    },
    "./fixtures": {
      "types": "./dist/fixtures.d.ts",
      "import": "./dist/fixtures.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "author": "Jacob Stewart <jacob@swarmauri.com>",
  "homepage": "https://mdwrk.com"
}
