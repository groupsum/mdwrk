{
  "version": "1.0.0",
  "type": "module",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20 <23"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "name": "@mdwrk/theme-draft",
  "description": "Draft-state helpers for contract-valid MdWrk theme editing sessions.",
  "sideEffects": false,
  "keywords": [
    "markdown-workspace",
    "shared",
    "themes",
    "drafts"
  ],
  "dependencies": {
    "@mdwrk/theme-contract": "^1.1.5"
  },
  "scripts": {
    "build:deps": "npm run build -w @mdwrk/theme-contract",
    "build": "npm run build:deps && tsc -p tsconfig.json",
    "typecheck": "npm run build:deps && tsc --noEmit -p tsconfig.json",
    "lint": "npm run typecheck",
    "test": "npm run build && node ../../../tools/testing/prepare-workspace-links.mjs @mdwrk/theme-contract @mdwrk/ui-tokens && node ./tests/theme-draft.t0.mjs && node ./tests/theme-draft.t1.mjs && node ./tests/theme-draft.t2.mjs",
    "prepack": "npm run build"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./version": {
      "types": "./dist/version.d.ts",
      "import": "./dist/version.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    },
    "./draft": {
      "types": "./dist/draft.d.ts",
      "import": "./dist/draft.js"
    },
    "./patches": {
      "types": "./dist/patches.d.ts",
      "import": "./dist/patches.js"
    },
    "./history": {
      "types": "./dist/history.d.ts",
      "import": "./dist/history.js"
    },
    "./validation": {
      "types": "./dist/validation.d.ts",
      "import": "./dist/validation.js"
    },
    "./import-export": {
      "types": "./dist/importExport.d.ts",
      "import": "./dist/importExport.js"
    },
    "./presets": {
      "types": "./dist/presets.d.ts",
      "import": "./dist/presets.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "author": "Jacob Stewart <jacob@swarmauri.com>",
  "homepage": "https://mdwrk.com"
}
