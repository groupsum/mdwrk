{
  "version": "1.0.0",
  "type": "module",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20 <23"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "name": "@mdwrk/theme-specimens",
  "description": "Canonical preview specimens and scenarios for MdWrk theme review and regression testing.",
  "sideEffects": false,
  "keywords": [
    "markdown-workspace",
    "shared",
    "themes",
    "specimens"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "npm run typecheck",
    "test": "npm run build && node ./tests/theme-specimens.t0.mjs && node ./tests/theme-specimens.t1.mjs && node ./tests/theme-specimens.t2.mjs",
    "prepack": "npm run build"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./version": {
      "types": "./dist/version.d.ts",
      "import": "./dist/version.js"
    },
    "./markdown-samples": {
      "types": "./dist/markdownSamples.d.ts",
      "import": "./dist/markdownSamples.js"
    },
    "./editor-samples": {
      "types": "./dist/editorSamples.d.ts",
      "import": "./dist/editorSamples.js"
    },
    "./ui-specimens": {
      "types": "./dist/uiSpecimens.d.ts",
      "import": "./dist/uiSpecimens.js"
    },
    "./preview-scenarios": {
      "types": "./dist/previewScenarios.d.ts",
      "import": "./dist/previewScenarios.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "author": "Jacob Stewart <jacob@swarmauri.com>",
  "homepage": "https://mdwrk.com"
}
