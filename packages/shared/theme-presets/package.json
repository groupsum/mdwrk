{
  "version": "1.0.0",
  "type": "module",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20 <23"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "name": "@mdwrk/theme-presets",
  "description": "First-party MdWrk theme presets and preset registry helpers.",
  "sideEffects": false,
  "keywords": [
    "markdown-workspace",
    "shared",
    "themes",
    "presets"
  ],
  "dependencies": {
    "@mdwrk/theme-contract": "^1.1.5"
  },
  "scripts": {
    "build:deps": "npm run build -w @mdwrk/theme-contract",
    "build": "npm run build:deps && tsc -p tsconfig.json",
    "typecheck": "npm run build:deps && tsc --noEmit -p tsconfig.json",
    "lint": "npm run typecheck",
    "test": "npm run build && node ../../../tools/testing/prepare-workspace-links.mjs @mdwrk/theme-contract && node ./tests/theme-presets.t0.mjs && node ./tests/theme-presets.t1.mjs && node ./tests/theme-presets.t2.mjs",
    "prepack": "npm run build"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./version": {
      "types": "./dist/version.d.ts",
      "import": "./dist/version.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    },
    "./metadata": {
      "types": "./dist/metadata.d.ts",
      "import": "./dist/metadata.js"
    },
    "./registry": {
      "types": "./dist/registry.d.ts",
      "import": "./dist/registry.js"
    },
    "./presets/default": {
      "types": "./dist/presets/default.d.ts",
      "import": "./dist/presets/default.js"
    },
    "./presets/graphite": {
      "types": "./dist/presets/graphite.d.ts",
      "import": "./dist/presets/graphite.js"
    },
    "./presets/paper": {
      "types": "./dist/presets/paper.d.ts",
      "import": "./dist/presets/paper.js"
    },
    "./presets/nocturne": {
      "types": "./dist/presets/nocturne.d.ts",
      "import": "./dist/presets/nocturne.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "author": "Jacob Stewart <jacob@swarmauri.com>",
  "homepage": "https://mdwrk.com"
}
