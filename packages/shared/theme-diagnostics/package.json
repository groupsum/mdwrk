{
  "version": "1.0.0",
  "type": "module",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20 <23"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "name": "@mdwrk/theme-diagnostics",
  "description": "Diagnostics and validation helpers for MdWrk theme drafts and presets.",
  "sideEffects": false,
  "keywords": [
    "markdown-workspace",
    "shared",
    "themes",
    "diagnostics"
  ],
  "dependencies": {
    "@mdwrk/theme-contract": "^1.1.5",
    "@mdwrk/ui-tokens": "^1.2.6"
  },
  "scripts": {
    "build:deps": "npm run build -w @mdwrk/theme-contract && npm run build -w @mdwrk/ui-tokens",
    "build": "npm run build:deps && tsc -p tsconfig.json",
    "typecheck": "npm run build:deps && tsc --noEmit -p tsconfig.json",
    "lint": "npm run typecheck",
    "test": "npm run build && node ../../../tools/testing/prepare-workspace-links.mjs @mdwrk/theme-contract @mdwrk/ui-tokens && node ./tests/theme-diagnostics.t0.mjs && node ./tests/theme-diagnostics.t1.mjs && node ./tests/theme-diagnostics.t2.mjs",
    "prepack": "npm run build"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./version": {
      "types": "./dist/version.d.ts",
      "import": "./dist/version.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    },
    "./validate-tokens": {
      "types": "./dist/validateTokens.d.ts",
      "import": "./dist/validateTokens.js"
    },
    "./validate-bridges": {
      "types": "./dist/validateBridges.d.ts",
      "import": "./dist/validateBridges.js"
    },
    "./validate-preset-coverage": {
      "types": "./dist/validatePresetCoverage.d.ts",
      "import": "./dist/validatePresetCoverage.js"
    },
    "./check-contrast": {
      "types": "./dist/checkContrast.d.ts",
      "import": "./dist/checkContrast.js"
    },
    "./collect-diagnostics": {
      "types": "./dist/collectDiagnostics.d.ts",
      "import": "./dist/collectDiagnostics.js"
    },
    "./format-diagnostics": {
      "types": "./dist/formatDiagnostics.d.ts",
      "import": "./dist/formatDiagnostics.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "author": "Jacob Stewart <jacob@swarmauri.com>",
  "homepage": "https://mdwrk.com"
}
