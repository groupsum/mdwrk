{
  "version": "1.0.0",
  "type": "module",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20 <23"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "name": "@mdwrk/theme-export",
  "description": "Export helpers for MdWrk theme presets, bundles, and CSS output.",
  "sideEffects": false,
  "keywords": [
    "markdown-workspace",
    "shared",
    "themes",
    "export"
  ],
  "dependencies": {
    "@mdwrk/theme-contract": "^1.1.5",
    "@mdwrk/ui-tokens": "^1.2.6"
  },
  "scripts": {
    "build:deps": "npm run build -w @mdwrk/theme-contract && npm run build -w @mdwrk/ui-tokens",
    "build": "npm run build:deps && tsc -p tsconfig.json",
    "typecheck": "npm run build:deps && tsc --noEmit -p tsconfig.json",
    "lint": "npm run typecheck",
    "test": "npm run build && node ../../../tools/testing/prepare-workspace-links.mjs @mdwrk/theme-contract @mdwrk/ui-tokens && node ./tests/theme-export.t0.mjs && node ./tests/theme-export.t1.mjs && node ./tests/theme-export.t2.mjs",
    "prepack": "npm run build"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./version": {
      "types": "./dist/version.d.ts",
      "import": "./dist/version.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    },
    "./export-theme-json": {
      "types": "./dist/exportThemeJson.d.ts",
      "import": "./dist/exportThemeJson.js"
    },
    "./export-theme-css": {
      "types": "./dist/exportThemeCss.d.ts",
      "import": "./dist/exportThemeCss.js"
    },
    "./export-bridge-css": {
      "types": "./dist/exportBridgeCss.d.ts",
      "import": "./dist/exportBridgeCss.js"
    },
    "./export-manifest": {
      "types": "./dist/exportManifest.d.ts",
      "import": "./dist/exportManifest.js"
    },
    "./export-bundle": {
      "types": "./dist/exportBundle.d.ts",
      "import": "./dist/exportBundle.js"
    },
    "./theme-package-artifact": {
      "types": "./dist/themePackageArtifact.d.ts",
      "import": "./dist/themePackageArtifact.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "author": "Jacob Stewart <jacob@swarmauri.com>",
  "homepage": "https://mdwrk.com"
}
